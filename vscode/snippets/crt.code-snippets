{
  "Chinese Remainder Theorem": {
    "scope": "cpp",
    "prefix": "crt chinese remainder theorem",
    "body": [
      "int extended_euclidean(int a, int b, int *x, int *y)",
      "{",
      "\tif (a == 0) {",
      "\t\t*x = 0; *y = 1;",
      "\t\treturn b;",
      "\t}",
      "\tint x1, y1;",
      "\tint gcd = extended_euclidean(b % a, a, &x1, &y1);",
      "\t*x = y1 - (b / a) * x1;",
      "\t*y = x1;",
      "\treturn gcd;",
      "}",
      "",
      "int inverse(int a, int m) {",
      "\tint x, y;",
      "\tint g = extended_euclidean(a, m, &x, &y);",
      "\tif (g != 1) {",
      "\t\treturn -1;",
      "\t}",
      "\telse {",
      "\t\tx = (x % m + m) % m;",
      "\t\treturn x;",
      "\t}",
      "}",
      "",
      "//(residue[],modulus[],modulus product) ",
      "int crt(vi a, vi m, int M) {",
      "\tint n = a.size();",
      "\tvi c(n); vi Mi(n);",
      "\tfor (int i = 0; i < n; i++) {",
      "\t\tMi[i] = M / m[i];",
      "\t}",
      "",
      "\tfor (int i = 0; i < n; i++) {",
      "\t\tc[i] = Mi[i] * (inverse(Mi[i], m[i]));",
      "\t}",
      "",
      "\tint x = 0;",
      "\tfor (int i = 0; i < n; ++i) {",
      "\t\tx += a[i] * c[i];",
      "\t\tx %= M;",
      "\t}",
      "",
      "\treturn x;",
      "}"
    ],
    "description": "Chinese Remainder Theorem"
  }
}
