{
  "Factorial Inverse": {
    "scope": "cpp",
    "prefix": "factorial",
    "body": [
      "#define ll long long",
      "const int N = 1000001;",
      "using namespace std;",
      "",
      "ll factorialNumInverse[N + 1];",
      "ll naturalNumInverse[N + 1];",
      "ll fact[N + 1];",
      "",
      "void InverseofNumber(ll p)",
      "{",
      "\tnaturalNumInverse[0] = naturalNumInverse[1] = 1;",
      "\tfor (int i = 2; i <= N; i++)",
      "\t\tnaturalNumInverse[i] = naturalNumInverse[p % i] * (p - p / i) % p;",
      "}",
      "",
      "void InverseofFactorial(ll p)",
      "{",
      "\tfactorialNumInverse[0] = factorialNumInverse[1] = 1;",
      "\tfor (int i = 2; i <= N; i++)",
      "\t\tfactorialNumInverse[i] = (naturalNumInverse[i] * factorialNumInverse[i - 1]) % p;",
      "}",
      "",
      "void factorial(ll p)",
      "{",
      "\tfact[0] = 1;",
      "",
      "\tfor (int i = 1; i <= N; i++) {",
      "\t\tfact[i] = (fact[i - 1] * i) % p;",
      "\t}",
      "}",
      "",
      "ll Binomial(ll N, ll R, ll p)",
      "{",
      "",
      "\tll ans = ((fact[N] * factorialNumInverse[R])",
      "\t          % p * factorialNumInverse[N - R])",
      "\t         % p;",
      "\treturn ans;",
      "}",
      "",
      "int main()",
      "{",
      "",
      "\tll p = 1000000007;",
      "\tInverseofNumber(p);",
      "\tInverseofFactorial(p);",
      "\tfactorial(p);",
      "\t// 1st query",
      "\tll N = 15;",
      "\tll R = 4;",
      "\tcout << Binomial(N, R, p) << endl;",
      "\t// 2nd query",
      "\tN = 20;",
      "\tR = 3;",
      "\tcout << Binomial(N, R, p) << endl;",
      "\treturn 0;",
      "}"
    ],
    "description": "Factorial Inverse"
  }
}
