  "Montogeometry Pollard": {
    "scope": "cpp",
    "prefix": "montogeometry pollard rho",
    "body": [
      "// https://judge.yosupo.jp/submission/23126",
      "namespace inner {",
      "",
      "using i32 = int32_t;",
      "using u32 = uint32_t;",
      "using i64 = int64_t;",
      "using u64 = uint64_t;",
      "",
      "template <typename T> T gcd(T a, T b) {",
      "\twhile (b) swap(a %= b, b);",
      "\treturn a;",
      "}",
      "",
      "uint64_t gcd_impl(uint64_t n, uint64_t m) {",
      "\tconstexpr uint64_t K = 5;",
      "\tfor (int i = 0; i < 80; ++i) {",
      "\t\tuint64_t t = n - m;",
      "\t\tuint64_t s = n - m * K;",
      "\t\tbool q = t < m;",
      "\t\tbool p = t < m * K;",
      "\t\tn = q ? m : t;",
      "\t\tm = q ? t : m;",
      "\t\tif (m == 0) return n;",
      "\t\tn = p ? n : s;",
      "\t}",
      "\treturn gcd_impl(m, n % m);",
      "}",
      "",
      "uint64_t gcd_pre(uint64_t n, uint64_t m) {",
      "\tfor (int i = 0; i < 4; ++i) {",
      "\t\tuint64_t t = n - m;",
      "\t\tbool q = t < m;",
      "\t\tn = q ? m : t;",
      "\t\tm = q ? t : m;",
      "\t\tif (m == 0) return n;",
      "\t}",
      "\treturn gcd_impl(n, m);",
      "}",
      "",
      "uint64_t gcd_fast(uint64_t n, uint64_t m) { return n > m ? gcd_pre(n, m) : gcd_pre(m, n); }",
      "",
      "template <typename T = int32_t> T inv(T a, T p) {",
      "\tT b = p, x = 1, y = 0;",
      "\twhile (a) {",
      "\t\tT q = b % a;",
      "\t\tswap(a, b /= a);",
      "\t\tswap(x, y -= q * x);",
      "\t}",
      "\tassert(b == 1);",
      "\treturn y < 0 ? y + p : y;",
      "}",
      "",
      "template <typename T = int32_t, typename U = int64_t> T modpow(T a, U n, T p) {",
      "\tT ret = 1;",
      "\tfor (; n; n >>= 1, a = U(a) * a % p)",
      "\t\tif (n & 1) ret = U(ret) * a % p;",
      "\treturn ret;",
      "}",
      "",
      "} // namespace inner",
      "",
      "using namespace std;",
      "",
      "unsigned long long mrng() {",
      "\tstatic unsigned long long x_ = 88172645463325252ULL;",
      "\tx_ = x_ ^ (x_ << 7);",
      "\treturn x_ = x_ ^ (x_ >> 9);",
      "}",
      "using namespace std;",
      "",
      "struct ArbitraryLazyMontgomeryModInt {",
      "\tusing mint = ArbitraryLazyMontgomeryModInt;",
      "\tusing i32 = int32_t;",
      "\tusing u32 = uint32_t;",
      "\tusing u64 = uint64_t;",
      "",
      "\tstatic u32 mod;",
      "\tstatic u32 r;",
      "\tstatic u32 n2;",
      "",
      "\tstatic u32 get_r() {",
      "\t\tu32 ret = mod;",
      "\t\tfor (i32 i = 0; i < 4; ++i) ret *= 2 - mod * ret;",
      "\t\treturn ret;",
      "\t}",
      "",
      "\tstatic void set_mod(u32 m) {",
      "\t\tassert(m < (1 << 30));",
      "\t\tassert((m & 1) == 1);",
      "\t\tmod = m;",
      "\t\tn2 = -u64(m) % m;",
      "\t\tr = get_r();",
      "\t\tassert(r * mod == 1);",
      "\t}",
      "",
      "\tu32 a;",
      "",
      "\tArbitraryLazyMontgomeryModInt() : a(0) {}",
      "\tArbitraryLazyMontgomeryModInt(const int64_t &b) : a(reduce(u64(b % mod + mod) * n2)) {};",
      "",
      "\tstatic u32 reduce(const u64 &b) { return (b + u64(u32(b) * u32(-r)) * mod) >> 32; }",
      "",
      "\tmint &operator+=(const mint &b) {",
      "\t\tif (i32(a += b.a - 2 * mod) < 0) a += 2 * mod;",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint &operator-=(const mint &b) {",
      "\t\tif (i32(a -= b.a) < 0) a += 2 * mod;",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint &operator*=(const mint &b) {",
      "\t\ta = reduce(u64(a) * b.a);",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint &operator/=(const mint &b) {",
      "\t\t*this *= b.inverse();",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint operator+(const mint &b) const { return mint(*this) += b; }",
      "\tmint operator-(const mint &b) const { return mint(*this) -= b; }",
      "\tmint operator*(const mint &b) const { return mint(*this) *= b; }",
      "\tmint operator/(const mint &b) const { return mint(*this) /= b; }",
      "\tbool operator==(const mint &b) const { return (a >= mod ? a - mod : a) == (b.a >= mod ? b.a - mod : b.a); }",
      "\tbool operator!=(const mint &b) const { return (a >= mod ? a - mod : a) != (b.a >= mod ? b.a - mod : b.a); }",
      "\tmint operator-() const { return mint() - mint(*this); }",
      "",
      "\tmint pow(u64 n) const {",
      "\t\tmint ret(1), mul(*this);",
      "\t\twhile (n > 0) {",
      "\t\t\tif (n & 1) ret *= mul;",
      "\t\t\tmul *= mul;",
      "\t\t\tn >>= 1;",
      "\t\t}",
      "\t\treturn ret;",
      "\t}",
      "",
      "\tfriend ostream &operator<<(ostream &os, const mint &b) { return os << b.get(); }",
      "",
      "\tfriend istream &operator>>(istream &is, mint &b) {",
      "\t\tint64_t t;",
      "\t\tis >> t;",
      "\t\tb = ArbitraryLazyMontgomeryModInt(t);",
      "\t\treturn (is);",
      "\t}",
      "",
      "\tmint inverse() const { return pow(mod - 2); }",
      "",
      "\tu32 get() const {",
      "\t\tu32 ret = reduce(a);",
      "\t\treturn ret >= mod ? ret - mod : ret;",
      "\t}",
      "",
      "\tstatic u32 get_mod() { return mod; }",
      "};",
      "typename ArbitraryLazyMontgomeryModInt::u32 ArbitraryLazyMontgomeryModInt::mod;",
      "typename ArbitraryLazyMontgomeryModInt::u32 ArbitraryLazyMontgomeryModInt::r;",
      "typename ArbitraryLazyMontgomeryModInt::u32 ArbitraryLazyMontgomeryModInt::n2;",
      "",
      "using namespace std;",
      "",
      "struct montgomery64 {",
      "\tusing mint = montgomery64;",
      "\tusing i64 = int64_t;",
      "\tusing u64 = uint64_t;",
      "\tusing u128 = __uint128_t;",
      "",
      "\tstatic u64 mod;",
      "\tstatic u64 r;",
      "\tstatic u64 n2;",
      "",
      "\tstatic u64 get_r() {",
      "\t\tu64 ret = mod;",
      "\t\tfor (i64 i = 0; i < 5; ++i) ret *= 2 - mod * ret;",
      "\t\treturn ret;",
      "\t}",
      "",
      "\tstatic void set_mod(u64 m) {",
      "\t\tassert(m < (1LL << 62));",
      "\t\tassert((m & 1) == 1);",
      "\t\tmod = m;",
      "\t\tn2 = -u128(m) % m;",
      "\t\tr = get_r();",
      "\t\tassert(r * mod == 1);",
      "\t}",
      "",
      "\tu64 a;",
      "",
      "\tmontgomery64() : a(0) {}",
      "\tmontgomery64(const int64_t &b) : a(reduce((u128(b) + mod) * n2)) {};",
      "",
      "\tstatic u64 reduce(const u128 &b) { return (b + u128(u64(b) * u64(-r)) * mod) >> 64; }",
      "",
      "\tmint &operator+=(const mint &b) {",
      "\t\tif (i64(a += b.a - 2 * mod) < 0) a += 2 * mod;",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint &operator-=(const mint &b) {",
      "\t\tif (i64(a -= b.a) < 0) a += 2 * mod;",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint &operator*=(const mint &b) {",
      "\t\ta = reduce(u128(a) * b.a);",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint &operator/=(const mint &b) {",
      "\t\t*this *= b.inverse();",
      "\t\treturn *this;",
      "\t}",
      "",
      "\tmint operator+(const mint &b) const { return mint(*this) += b; }",
      "\tmint operator-(const mint &b) const { return mint(*this) -= b; }",
      "\tmint operator*(const mint &b) const { return mint(*this) *= b; }",
      "\tmint operator/(const mint &b) const { return mint(*this) /= b; }",
      "\tbool operator==(const mint &b) const { return (a >= mod ? a - mod : a) == (b.a >= mod ? b.a - mod : b.a); }",
      "\tbool operator!=(const mint &b) const { return (a >= mod ? a - mod : a) != (b.a >= mod ? b.a - mod : b.a); }",
      "\tmint operator-() const { return mint() - mint(*this); }",
      "",
      "\tmint pow(u128 n) const {",
      "\t\tmint ret(1), mul(*this);",
      "\t\twhile (n > 0) {",
      "\t\t\tif (n & 1) ret *= mul;",
      "\t\t\tmul *= mul;",
      "\t\t\tn >>= 1;",
      "\t\t}",
      "\t\treturn ret;",
      "\t}",
      "",
      "\tfriend ostream &operator<<(ostream &os, const mint &b) { return os << b.get(); }",
      "",
      "\tfriend istream &operator>>(istream &is, mint &b) {",
      "\t\tint64_t t;",
      "\t\tis >> t;",
      "\t\tb = montgomery64(t);",
      "\t\treturn (is);",
      "\t}",
      "",
      "\tmint inverse() const { return pow(mod - 2); }",
      "",
      "\tu64 get() const {",
      "\t\tu64 ret = reduce(a);",
      "\t\treturn ret >= mod ? ret - mod : ret;",
      "\t}",
      "",
      "\tstatic u64 get_mod() { return mod; }",
      "};",
      "typename montgomery64::u64 montgomery64::mod, montgomery64::r, montgomery64::n2;",
      "",
      "namespace fast_factorize {",
      "using u64 = uint64_t;",
      "",
      "template <typename mint> bool miller_rabin(u64 n, vector<u64> as) {",
      "\tif (mint::get_mod() != n) mint::set_mod(n);",
      "\tu64 d = n - 1;",
      "\twhile (~d & 1) d >>= 1;",
      "\tmint e{1}, rev{int64_t(n - 1)};",
      "\tfor (u64 a : as) {",
      "\t\tif (n <= a) break;",
      "\t\tu64 t = d;",
      "\t\tmint y = mint(a).pow(t);",
      "\t\twhile (t != n - 1 && y != e && y != rev) {",
      "\t\t\ty *= y;",
      "\t\t\tt *= 2;",
      "\t\t}",
      "\t\tif (y != rev && t % 2 == 0) return false;",
      "\t}",
      "\treturn true;",
      "}",
      "",
      "bool is_prime(u64 n) {",
      "\tif (~n & 1) return n == 2;",
      "\tif (n <= 1) return false;",
      "\tif (n < (1LL << 30))",
      "\t\treturn miller_rabin<ArbitraryLazyMontgomeryModInt>(n, {2, 7, 61});",
      "\telse",
      "\t\treturn miller_rabin<montgomery64>(n, {2, 325, 9375, 28178, 450775, 9780504, 1795265022});",
      "}",
      "",
      "template <typename mint, typename T> T pollard_rho(T n) {",
      "\tif (~n & 1) return 2;",
      "\tif (is_prime(n)) return n;",
      "\tif (mint::get_mod() != n) mint::set_mod(n);",
      "\tmint R, one = 1;",
      "\tauto f = [&](mint x) { return x * x + R; };",
      "\tauto rnd = [&]() { return mrng() % (n - 2) + 2; };",
      "\twhile (1) {",
      "\t\tmint x, y, ys, q = one;",
      "\t\tR = rnd(), y = rnd();",
      "\t\tT g = 1;",
      "\t\tconstexpr int m = 128;",
      "\t\tfor (int r = 1; g == 1; r <<= 1) {",
      "\t\t\tx = y;",
      "\t\t\tfor (int i = 0; i < r; ++i) y = f(y);",
      "\t\t\tfor (int k = 0; g == 1 && k < r; k += m) {",
      "\t\t\t\tys = y;",
      "\t\t\t\tfor (int i = 0; i < m && i < r - k; ++i) q *= x - (y = f(y));",
      "\t\t\t\tg = inner::gcd_fast(q.get(), n);",
      "\t\t\t}",
      "\t\t}",
      "\t\tif (g == n) do",
      "\t\t\t\tg = inner::gcd_fast((x - (ys = f(ys))).get(), n);",
      "\t\t\twhile (g == 1);",
      "\t\tif (g != n) return g;",
      "\t}",
      "\texit(1);",
      "}",
      "",
      "vector<u64> inner_factorize(u64 n) {",
      "\tif (n <= 1) return {};",
      "\tu64 p;",
      "\tif (n <= (1LL << 30))",
      "\t\tp = pollard_rho<ArbitraryLazyMontgomeryModInt>(n);",
      "\telse",
      "\t\tp = pollard_rho<montgomery64>(n);",
      "\tif (p == n) return {p};",
      "\tauto l = inner_factorize(p);",
      "\tauto r = inner_factorize(n / p);",
      "\tcopy(begin(r), end(r), back_inserter(l));",
      "\treturn l;",
      "}",
      "",
      "vector<u64> factorize(u64 n) {",
      "\tauto ret = inner_factorize(n);",
      "\tsort(begin(ret), end(ret));",
      "\treturn ret;",
      "}",
      "",
      "vector<pair<long long, long long>> factorize_prime(long long n) {",
      "\tvector<u64> res = factorize(n);",
      "\tvector<pair<long long, long long>> ret;",
      "\tfor (int i = 0; i < res.size(); i++) {",
      "\t\tif (i == 0 || res[i] != res[i - 1]) ret.push_back({res[i], 1});",
      "\t\telse ret[ret.size() - 1].second++;",
      "\t}",
      "\treturn ret;",
      "}",
      "vector<long long> divisor(long long n) {",
      "\tvector<pair<long long, long long>> v = factorize_prime(n);",
      "\tvector<long long> ret;",
      "\tauto f = [&](auto rc, int i, long long x)->void{",
      "\t\tif (i == (int)v.size()) {",
      "\t\t\tret.push_back(x);",
      "\t\t\treturn;",
      "\t\t}",
      "\t\tfor (int j = 0; j <= v[i].second; j++) {",
      "\t\t\trc(rc, i + 1, x);",
      "\t\t\tx *= v[i].first;",
      "\t\t}",
      "\t};",
      "\tf(f, 0, 1);",
      "\tsort(ret.begin(), ret.end());",
      "\treturn ret;",
      "}",
      "",
      "} // namespace fast_factorize"
