{
  "Mint Normalisation": {
    "scope": "cpp",
    "prefix": "mint modular",
    "body": [
      "long long &P = mod;",
      "using i64 = long long;",
      "// assume -P <= x < 2P",
      "i64 narm(i64 x) {",
      "\tif (-P <= x && x < (P << 1ll)) {",
      "\t\tif (x < 0) {",
      "\t\t\tx += P;",
      "\t\t}",
      "\t\tif (x >= P) {",
      "\t\t\tx -= P;",
      "\t\t}",
      "\t\treturn x;",
      "\t}",
      "",
      "\tif (x < 0) {",
      "\t\tx += ((-x + P - 1) / P) * P;",
      "\t}",
      "\treturn x % P;",
      "}",
      "template<class T>",
      "T power(T a, i64 b) {",
      "\tT res = 1;",
      "\tfor (; b; b /= 2, a *= a) {",
      "\t\tif (b % 2) {",
      "\t\t\tres *= a;",
      "\t\t}",
      "\t}",
      "\treturn res;",
      "}",
      "struct mint {",
      "\ti64 x;",
      "\tmint(int32_t x = 0) : x(narm(x)) {}",
      "\tmint(i64 x) : x(narm(x)) {}",
      "\t// template<typename T>",
      "\t// operator T() const {",
      "\t// \treturn x;",
      "\t// }",
      "\ti64 val() const {",
      "\t\treturn x;",
      "\t}",
      "\tmint operator-() const {",
      "\t\treturn mint(narm(P - x));",
      "\t}",
      "\tmint pow(i64 m) {",
      "\t\treturn power(*this, m);",
      "\t}",
      "\tmint inv() const {",
      "\t\tassert(x != 0);",
      "\t\treturn power(*this, P - 2);",
      "\t}",
      "\tmint &operator*=(const mint &rhs) {",
      "\t\tx = i64(x) * rhs.x % P;",
      "\t\treturn *this;",
      "\t}",
      "\tmint &operator+=(const mint &rhs) {",
      "\t\tx = narm(x + rhs.x);",
      "\t\treturn *this;",
      "\t}",
      "\tmint &operator-=(const mint &rhs) {",
      "\t\tx = narm(x - rhs.x);",
      "\t\treturn *this;",
      "\t}",
      "\tmint &operator/=(const mint &rhs) {",
      "\t\treturn *this *= rhs.inv();",
      "\t}",
      "\tfriend mint operator*(const mint &lhs, const mint &rhs) {",
      "\t\tmint res = lhs;",
      "\t\tres *= rhs;",
      "\t\treturn res;",
      "\t}",
      "\tfriend mint operator+(const mint &lhs, const mint &rhs) {",
      "\t\tmint res = lhs;",
      "\t\tres += rhs;",
      "\t\treturn res;",
      "\t}",
      "\tfriend mint operator-(const mint &lhs, const mint &rhs) {",
      "\t\tmint res = lhs;",
      "\t\tres -= rhs;",
      "\t\treturn res;",
      "\t}",
      "\tfriend mint operator/(const mint &lhs, const mint &rhs) {",
      "\t\tmint res = lhs;",
      "\t\tres /= rhs;",
      "\t\treturn res;",
      "\t}",
      "\tmint& operator++() { return *this += 1; }",
      "\tmint& operator--() { return *this -= 1; }",
      "\tmint operator++(int32_t) { mint temp; temp.x = x++; return temp; }",
      "\tmint operator--(int32_t) { mint temp; temp.x = x--; return temp; }",
      "",
      "\tfriend std::istream &operator>>(std::istream &is, mint &a) {",
      "\t\ti64 v;",
      "\t\tis >> v;",
      "\t\ta = mint(v);",
      "\t\treturn is;",
      "\t}",
      "\tfriend std::ostream &operator<<(std::ostream &os, const mint &a) {",
      "\t\treturn os << a.val();",
      "\t}",
      "};",
      "#define mi mint",
      "#define i32 int32_t",
      "#define i64 long long",
      "",
      "void __print(mint y) {cerr << (y).x;}"
    ],
    "description": "Mint Normalisation"
  }
