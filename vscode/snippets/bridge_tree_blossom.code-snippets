{
  "Bridge Tree Blossom": {
    "scope": "cpp",
    "prefix": "bridge tree build",
    "body": [
      "vector<vector<int>> adj; // upd adj",
      "set<pair<int, int>> bridge_set;",
      "void IS_BRIDGE(int u, int v) {",
      "\t//this is called if edge u to v forms a bridge, do whatever you want",
      "\tbridge_set.insert({u, v});",
      "\tbridge_set.insert({v, u});",
      "}",
      "",
      "vector<bool> visited;",
      "vector<int> tin, low;",
      "int timer;",
      "",
      "void dfsa(int v, int p = -1) {",
      "\tvisited[v] = true;",
      "\ttin[v] = low[v] = timer++;",
      "\tfor (int to : adj[v]) {",
      "\t\tif (to == p) continue;",
      "\t\tif (visited[to]) {",
      "\t\t\tlow[v] = min(low[v], tin[to]);",
      "\t\t} else {",
      "\t\t\tdfsa(to, v);",
      "\t\t\tlow[v] = min(low[v], low[to]);",
      "\t\t\tif (low[to] > tin[v])",
      "\t\t\t\tIS_BRIDGE(v, to);",
      "\t\t}",
      "\t}",
      "}",
      "",
      "void find_bridges(int n) {",
      "        bridge_set.clear();",
      "\ttimer = 0;",
      "\tvisited.assign(n, false);",
      "\ttin.assign(n, -1);",
      "\tlow.assign(n, -1);",
      "\tfor (int i = 0; i < n; ++i) {",
      "\t\tif (!visited[i])",
      "\t\t\tdfsa(i);",
      "\t}",
      "}",
      "",
      "vector<int> id;",
      "vector<int> vis;",
      "void dfsb(int node, int component_number) {",
      "\tid[node] = component_number ;",
      "\tvis[node] = true;",
      "\tfor (auto &x : adj[node]) {",
      "\t\t//note extra O(logn) factor due to bridge set.",
      "\t\tif (!vis[x] && (bridge_set.find({node, x}) == bridge_set.end())) {",
      "\t\t\tint next = x;",
      "\t\t\tdfsb(next, component_number);",
      "\t\t}",
      "\t}",
      "}",
      "",
      "void blossom(int n) {",
      "\tvis.assign(n, 0);",
      "\tid.assign(n, 0);",
      "\tiota(all(id), 0);",
      "\t// int unique_component_number = 0;",
      "\tfor (int i = 0; i < n; i++) {",
      "\t\tif (!vis[i]) {",
      "\t\t\tdfsb(i, i);",
      "\t\t\t// unique_component_number++;",
      "\t\t}",
      "\t}",
      "}",
      "",
      "vector<vector<int>> bridge_tree;",
      "void bridge_tree_build(int n) {",
      "\tfind_bridges(n);",
      "\tblossom(n);",
      "",
      "        bridge_tree.clear();",
      "\tvector<vector<int>> &arr = bridge_tree;",
      "\tarr.assign(n, vector<int>());",
      "\tfor (auto &[a, b] : bridge_set) {",
      "\t\tif (id[a] == id[b])",
      "\t\t\tcontinue;",
      "\t\tarr[id[a]].push_back(id[b]);",
      "\t}",
      "}"
    ],
    "description": "Bridge Tree Blossom"
  }
}
