  "Polynomial Rolling Hash String One Mod": {
    "scope": "cpp",
    "prefix": "polynomial rolling string hash one mod",
    "body": [
      "typedef unsigned long long ull;",
      "",
      "int gen_base(int before, int after) {",
      "\tauto seed = std::chrono::high_resolution_clock::now().time_since_epoch().count();",
      "\tstd::mt19937 gen(seed ^ ull(new ull));",
      "\tstd::uniform_int_distribution<int> dist(before + 2, after - 1);",
      "\tint base = dist(gen);",
      "\treturn base % 2 == 0 ? base - 1 : base;",
      "}",
      "",
      "struct PolyHash {",
      "\t// -------- Static variables --------",
      "\tstatic const ull mod = (ull(1) << 61) - 1; // prime mod of hashing",
      "\t//mod = 6735249118018991;",
      "\tstatic int base;                           // odd base of hashing",
      "\tstatic std::vector<ull> pow;               // powers of base modulo mod;",
      "",
      "\t// -------- Static functions --------",
      "\tstatic inline ull add(ull a, ull b) {",
      "\t\t// Calculate (a + b) % mod, 0 <= a < mod, 0 <= b < mod",
      "\t\treturn (a += b) < mod ? a : a - mod;",
      "\t}",
      "",
      "\tstatic inline ull sub(ull a, ull b) {",
      "\t\t// Calculate (a - b) % mod, 0 <= a < mod, 0 <= b < mod",
      "\t\treturn (a -= b) < mod ? a : a + mod;",
      "\t}",
      "",
      "\tstatic inline ull mul(ull a, ull b) {",
      "\t\t// Calculate (a * b) % mod, 0 <= a < mod, 0 <= b < mod",
      "\t\tull l1 = (uint32_t)a, h1 = a >> 32, l2 = (uint32_t)b, h2 = b >> 32;",
      "\t\tull l = l1 * l2, m = l1 * h2 + l2 * h1, h = h1 * h2;",
      "\t\tull ret = (l & mod) + (l >> 61) + (h << 3) + (m >> 29) + (m << 35 >> 3) + 1;",
      "\t\tret = (ret & mod) + (ret >> 61);",
      "\t\tret = (ret & mod) + (ret >> 61);",
      "\t\treturn ret - 1;",
      "\t\t// __int128_t res = a; // for other primes(or composite?)",
      "\t\t// res *= b;",
      "\t\t// res %= mod;",
      "\t\t// return (ull)res;",
      "\t}",
      "",
      "\t// -------- Variables of class --------",
      "\tstd::vector<ull> pref; // polynomial hash on prefix",
      "",
      "\t// Constructor from string:",
      "\tPolyHash(const auto& s)",
      "\t\t: pref(s.size() + 1u, 0)",
      "\t{",
      "\t\t// Pre-calculate powers of base:",
      "\t\twhile (pow.size() <= s.size()) {",
      "\t\t\tpow.push_back(mul(pow.back(), base));",
      "\t\t}",
      "\t\t// Calculate polinomial hash on prefix:",
      "\t\tfor (int i = 0; i < (int)s.size(); ++i) {",
      "\t\t\tpref[i + 1] = add(mul(pref[i], base), s[i]);",
      "\t\t}",
      "\t}",
      "",
      "\t// Get hash from [pos, pos+len-1] segment of string",
      "\tinline ull operator()(const int pos, const int len) const {",
      "\t\treturn sub(pref[pos + len], mul(pref[pos], pow[len]));",
      "\t}",
      "",
      "};",
      "",
      "// Init static variables of class PolyHash:",
      "int PolyHash::base((int)1e9 + 7);",
      "std::vector<ull> PolyHash::pow{1};"
    ],
    "description": "Polynomial Rolling Hash String One Mod"
  }
