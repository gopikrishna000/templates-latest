{
  "Dynamic Segment Tree": {
    "scope": "cpp",
    "prefix": "dynamic segment tree",
    "body": [
      "struct Vertex {",
      "\tint left, right;",
      "\tint sum = 0;",
      "\tint lazy = 0;",
      "\tint neutral = 0;",
      "\tVertex *left_child = nullptr, *right_child = nullptr;",
      "",
      "\tVertex(int lb, int rb) {",
      "\t\tleft = lb;",
      "\t\tright = rb;",
      "\t}",
      "",
      "\tint joinDeltas(int oldDelta, int newDelta) {",
      "\t\treturn oldDelta + newDelta;",
      "\t}",
      "",
      "\tint joinValueWithDelta(int value, int delta, int length) {",
      "\t\treturn value + length * delta;",
      "\t}",
      "",
      "\tvoid push() { //own",
      "\t\tint tm = (left + right) / 2;",
      "\t\tleft_child->sum = joinValueWithDelta(left_child->sum, lazy , tm - left);",
      "\t\tleft_child->lazy = joinDeltas(left_child->lazy, lazy);",
      "\t\tright_child->sum = joinValueWithDelta(right_child->sum, lazy, right-tm);",
      "\t\tright_child->lazy = joinDeltas(right_child->lazy, lazy);",
      "\t\tlazy = 0;",
      "\t}",
      "",
      "\tvoid extend() {",
      "\t\tif (!left_child && left + 1 < right) {",
      "\t\t\tint t = (left + right) / 2;",
      "\t\t\tleft_child = new Vertex(left, t);",
      "\t\t\tright_child = new Vertex(t, right);",
      "\t\t}",
      "\t}",
      "",
      "\tvoid add(int k, int x) {",
      "\t\textend();",
      "\t\tsum += x;",
      "\t\tif (left_child) {",
      "\t\t\tpush();",
      "\t\t\tif (k < left_child->right)",
      "\t\t\t\tleft_child->add(k, x);",
      "\t\t\telse",
      "\t\t\t\tright_child->add(k, x);",
      "\t\t}",
      "\t}",
      "",
      "\tint get_sum2(int lq, int rq) {",
      "\t\tif (lq >= rq) return neutral;",
      "\t\tif (lq <= left && right <= rq)",
      "\t\t\treturn sum;",
      "\t\tif (max(left, lq) >= min(right, rq))",
      "\t\t\treturn neutral;",
      "\t\textend();",
      "\t\tpush();",
      "\t\treturn left_child->get_sum2(lq, rq) + right_child->get_sum2(lq, rq);",
      "\t}",
      "",
      "\tvoid update2(int lq, int rq, auto addend) { //own",
      "\t\tif (lq >= rq) return;",
      "\t\textend();",
      "\t\tif (!left_child) {assert((lq <= left && right <= rq ) || max(left, lq) >= min(right, rq));}",
      "\t\tif (lq <= left && right <= rq) {",
      "\t\t\tsum += (right - left) * addend;",
      "\t\t\tlazy += addend;",
      "\t\t}",
      "\t\telse if (max(left, lq) >= min(right, rq)) {",
      "\t\t\t//do ntg",
      "\t\t}",
      "\t\telse {",
      "\t\t\tpush();",
      "\t\t\tsum += (min(right, rq) - max(left, lq)) * addend;",
      "\t\t\tleft_child->update2(lq, rq, addend);",
      "\t\t\tright_child->update2(lq, rq, addend);",
      "\t\t}",
      "\t}",
      "\tint query(int lq, int rq) {return get_sum2(lq, rq + 1);}",
      "\tvoid update(int lq, int rq, auto addend) {update2(lq, rq + 1, addend);}",
      "};"
    ],
    "description": "Dynamic Segment Tree"
  }
