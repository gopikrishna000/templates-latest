{
  "NGE Stack": {
    "scope": "cpp",
    "prefix": "nge stack",
    "body": [
      "vector<int> pse, pge, nge, nse, nsee, pge1;",
      "void preprocess(vector<int> &arr) {",
      "\tint n = arr.size();",
      "\tpse.resize(n), pge.resize(n), nge.resize(n), nse.resize(n), nsee.resize(n), pge1.resize(n);",
      "\t// if giving default value like -2 smtg, then use assign instead of resize.",
      "",
      "\t//previous greater (including current element)",
      "\t//ie: if for given i, maximum range [x,i-1] such that min(x,i)=arr[i], then:pge[i]=x-1.",
      "\t{",
      "\t\tstack<int> st;",
      "\t\tfor (int i = 0; i < n; i++) {",
      "\t\t\twhile (!st.empty() && arr[st.top()] <= arr[i])",
      "\t\t\t\tst.pop();",
      "",
      "\t\t\tpge[i] = (st.empty() ? -1 : st.top());",
      "\t\t\tst.push(i);",
      "\t\t}",
      "\t}",
      "",
      "\t//nge //next greater element, in range [i+1,n-1]",
      "\t{",
      "\t\tstack<int> st;",
      "\t\tfor (int i = n - 1; i >= 0; i--) {",
      "\t\t\twhile (!st.empty() && arr[st.top()] <= arr[i])",
      "\t\t\t\tst.pop();",
      "",
      "\t\t\tnge[i] = (st.empty() ? n : st.top());",
      "\t\t\tst.push(i);",
      "\t\t}",
      "\t}",
      "",
      "\t//pse //prev smaller element",
      "\t{",
      "\t\tstack<int> st;",
      "\t\tfor (int i = 0; i < n; i++) {",
      "\t\t\twhile (!st.empty() && arr[st.top()] >= arr[i])",
      "\t\t\t\tst.pop();",
      "",
      "\t\t\tpse[i] = (st.empty() ? -1 : st.top());",
      "\t\t\tst.push(i);",
      "\t\t}",
      "\t}",
      "",
      "\t//nse //next smaller element",
      "\t{",
      "\t\tstack<int> st;",
      "\t\tfor (int i = n - 1; i >= 0; i--) {",
      "\t\t\twhile (!st.empty() && arr[st.top()] >= arr[i])",
      "\t\t\t\tst.pop();",
      "",
      "\t\t\tnse[i] = (st.empty() ? n  : st.top());",
      "\t\t\tst.push(i);",
      "\t\t}",
      "\t}",
      "",
      "\t//next smaller than or equal element in range [i+1,n-1]",
      "\t{",
      "\t\tstack<int> st;",
      "\t\tfor (int i = n - 1; i >= 0; i--) {",
      "\t\t\twhile (!st.empty() && arr[st.top()] > arr[i])",
      "\t\t\t\tst.pop();",
      "",
      "\t\t\tnsee[i] = (st.empty() ? n : st.top());",
      "\t\t\tst.push(i);",
      "\t\t}",
      "\t}",
      "",
      "\t//previous greater element plus 1",
      "\t//meaning that pse1[i]=x => min[x,i]=i but not x-1.",
      "\t{",
      "\t\tstack<int> st;",
      "\t\tfor (int i = 0; i < n; i++) {",
      "\t\t\twhile (!st.empty() && arr[st.top()] < arr[i])",
      "\t\t\t\tst.pop();",
      "",
      "\t\t\tpge1[i] = (st.empty() ? 0 : st.top() + 1);",
      "\t\t\tst.push(i);",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "NGE Stack"
  }
}
