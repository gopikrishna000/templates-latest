{
  "Online Divisor Using Primes": {
    "scope": "cpp",
    "prefix": "online divisors generator using prime factorisation",
    "body": [
      "#define N 1e6 + 1",
      "vector<int> prime;",
      "vector<vi> divisors(N+1); //memoization",
      "",
      "void prime_sieve() {",
      "\tint sq = sqrt(N);",
      "\tvector<bool> B(sq + 1, 0);",
      "\tfor (int i = 2; i <= sq; i++) {",
      "\t\tif (!B[i]) {",
      "\t\t\tprime.pb(i);",
      "\t\t\tfor (int j = i * 2; j <= sq; j += i) {",
      "\t\t\t\tB[j] = 1;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "}",
      "",
      "//generate prime divisors O(#p<sqrt(n) + logn)",
      "vector<pair<int, int>> prime_divisors(int n) {",
      "\tvector<pair<int, int>> f; //factorization",
      "\tif (n == 1) {",
      "\t\tf.pb({1, 1});",
      "\t\treturn f;",
      "\t}",
      "\tfor (auto &p : prime) {",
      "\t\tint c = 0;",
      "\t\tbool ok = 0;",
      "\t\twhile (n % p == 0) {",
      "\t\t\tc++;",
      "\t\t\tok = 1;",
      "\t\t\tn /= p;",
      "\t\t}",
      "\t\tif (ok)",
      "\t\t\tf.pb({p, c});",
      "\t}",
      "\tif (n != 1)",
      "\t\tf.pb({n, 1});",
      "\treturn f;",
      "}",
      "",
      "void gendiv(vector<pair<int, int>> &f, int ppos, vector<int> &div, int sofar) {",
      "\tif (ppos == f.size()) {",
      "\t\tdiv.pb(sofar);",
      "\t\treturn;",
      "\t}",
      "\tint pexp = 1;",
      "\tfor (int i = 0; i <= f[ppos].second; i++) {",
      "\t\tgendiv(f, ppos + 1, div, sofar * pexp);",
      "\t\tpexp *= f[ppos].first;",
      "\t}",
      "}",
      "",
      "//generate divisors //not in sorted order",
      "vector<int> generate_divisors(int n) {",
      "\tvector<int> div;",
      "\tvector<pair<int, int>> f = prime_divisors(n);",
      "\tgendiv(f, 0, div, 1);",
      "\treturn div;",
      "}"
    ],
    "description": "Online Divisor Using Primes"
  }
