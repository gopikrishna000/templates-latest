{
  "LCA": {
    "scope": "cpp",
    "prefix": "lca",
    "body": [
      "int n, l;",
      "vector<vector<int>> adj; //upd adj",
      "int _q = 0; //update it to _q if wt ed tree is used",
      "vector<vector<pair<int, int>>> wadj;",
      "vector<int> wt;",
      "",
      "int timer;",
      "vector<int> tin, tout, depth;",
      "vector<vector<int>> up;",
      "",
      "void dfs(int v, int p, int dep) //depth is extra,in case needed...",
      "{",
      "\ttin[v] = ++timer;",
      "\tup[v][0] = p;",
      "\tdepth[v] = dep;",
      "\tfor (int i = 1; i <= l; ++i)",
      "\t\tup[v][i] = up[up[v][i - 1]][i - 1];",
      "",
      "\tfor (int u : adj[v]) {",
      "\t\tif (u != p)",
      "\t\t\tdfs(u, v, dep + 1);",
      "\t}",
      "",
      "\ttout[v] = ++timer;",
      "}",
      "",
      "void wdfs(int v, int p, int sofar)",
      "{",
      "\twt[v] = sofar;",
      "\tfor (auto &[u, w] : wadj[v]) {",
      "\t\tif (u != p)",
      "\t\t\twdfs(u, v, sofar + w);",
      "\t}",
      "}",
      "",
      "bool is_ancestor(int u, int v)",
      "{",
      "\treturn tin[u] <= tin[v] && tout[u] >= tout[v];",
      "}",
      "",
      "int lca(int u, int v)",
      "{",
      "\tif (is_ancestor(u, v))",
      "\t\treturn u;",
      "\tif (is_ancestor(v, u))",
      "\t\treturn v;",
      "\tfor (int i = l; i >= 0; --i) {",
      "\t\tif (!is_ancestor(up[u][i], v))",
      "\t\t\tu = up[u][i];",
      "\t}",
      "\treturn up[u][0];",
      "}",
      "",
      "int distance(int u, int v) {",
      "\tint anc = lca(u, v);",
      "\treturn abs(depth[u] - depth[anc]) + abs(depth[anc] - depth[v]);",
      "}",
      "",
      "int weight(int u, int v) {",
      "\tint anc = lca(u, v);",
      "\treturn abs(wt[u] - wt[anc]) + abs(wt[anc] - wt[v]);",
      "}",
      "",
      "void preprocess(int root) {",
      "        n = adj.size();",
      "\ttin.resize(n);",
      "\ttout.resize(n);",
      "\tdepth.resize(n);",
      "\ttimer = 0;",
      "\tl = ceil(log2(n));",
      "\tup.assign(n, vector<int>(l + 1));",
      "\tdfs(root, root, 0);",
      "\tif(_q){",
      "\t\twt.resize(n);",
      "\t\twdfs(root,root,0);",
      "\t}",
      "}"
    ],
    "description": "LCA"
  }
}
