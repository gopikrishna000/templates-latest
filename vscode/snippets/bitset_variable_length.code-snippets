{
  "Variable Size Bitset": {
    "scope": "cpp",
    "prefix": "variable size bitset",
    "body": [
      "const int MAXLEN = 1e9+7;",
      "template <int len = 1>",
      "void solve(int n) {",
      "\tif (n > len) {",
      "\t\tsolve<std::min(len * 2, MAXLEN)>(n);",
      "\t\treturn;",
      "\t}",
      "\t// solution using bitset<len>",
      "\tbitset<len> s;",
      "\tcout << s.size();",
      "}",
      "",
      "variable n;",
      "solve(n);"
    ],
    "description": "Variable Size Bitset"
  }
}
