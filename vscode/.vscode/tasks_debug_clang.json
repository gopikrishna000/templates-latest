{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run (clang++ debug)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "-ggdb3",
                "-std=c++23",
                "-O2",
                "-Wshadow",
                "-Wformat=2",
                "-Wfloat-equal",
                "-Wconversion",
                "-Wshift-overflow",
                "-Wcast-qual",
                "-Wcast-align",
                "-fsanitize=address",
                "-fsanitize=undefined",
                "-fno-sanitize-recover",
                "-fstack-protector",
                "-D",
                "LOCAL",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "run executable (clang++ debug)",
            "type": "shell",
            "command": "gtimeout",
            "args": [
                "-s",
                "SIGKILL",
                "3",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "build and run (clang++ debug)"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file (debug)",
            "command": "clang++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++23",
                "-fsanitize=address",
                "-fsanitize=undefined",
                "-D",
                "LOCAL",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Debug build with clang++ and sanitizers"
        }
    ]
}
